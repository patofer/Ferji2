<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Para PDFs en la raíz del directorio de caché -->
    <cache-path name="pdf_cache_root" path="." />

    <!-- Para imágenes en el subdirectorio 'images' del caché -->
